#!/usr/bin/env node

/**
 * wicnode: Web-Import-with-Cache runner for Node.js
 */

import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const registerHookPath = path.resolve(__dirname, '../src/node/register_hook.js');
const VERSION = '0.1.0';

function printHelp () {
	console.log(`
WebLoad Node Runner (wicnode)

Usage:
  wicnode [options] <file-or-url> [script-args...]

Options:
  --config <path>    Specify path to webload.json configuration
  -h, --help         Show this help message
  -v, --version      Show version
`);
}

async function main () {
	const args = process.argv.slice(2);
	const help = args.includes('-h') || args.includes('--help');

	if (args.length === 0 || help) {
		printHelp();
		process.exit(help ? 0 : 1);
	}

	if (args.includes('-v') || args.includes('--version')) {
		console.log(`wicnode ${VERSION}`);
		process.exit(0);
	}

	let configPath = null;
	const nodeArgs = [];
	let entrypoint = null;
	const scriptArgs = [];

	let i = 0;
	while (i < args.length) {
		const arg = args[i];

		if (arg === '--config') {
			configPath = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--config=')) {
			configPath = arg.slice(9);
			i += 1;
		} else if (!entrypoint && !arg.startsWith('-')) {
			entrypoint = arg;
			i += 1;
			// Everything after entrypoint is passed to the script
			scriptArgs.push(...args.slice(i));
			break;
		} else {
			if (!entrypoint) {
				nodeArgs.push(arg);
			} else {
				scriptArgs.push(arg);
			}
			i += 1;
		}
	}

	if (!entrypoint) {
		console.error('Error: No entrypoint script or URL specified.');
		printHelp();
		process.exit(1);
	}

	const env = Object.assign({}, process.env);
	env.WEBLOAD_MAIN = entrypoint;
	if (configPath) {
		env.WEBLOAD_CONFIG = path.resolve(process.cwd(), configPath);
	}

	const finalArgs = [
		'--import', registerHookPath,
		...nodeArgs,
		'WEBLOAD:MAIN',
		...scriptArgs
	];

	// Use process.execve when available on non-Windows platforms for process replacement
	if (process.platform !== 'win32' && typeof process.execve === 'function') {
		const fullArgv = [process.execPath, ...finalArgs];
		process.execve(process.execPath, fullArgv, env);
		return;
	}

	const child = spawn(process.execPath, finalArgs, {
		stdio: 'inherit',
		env
	});

	child.on('exit', function (code, signal) {
		if (signal) {
			process.kill(process.pid, signal);
		} else {
			process.exit(code ?? 0);
		}
	});
}

main().catch(function (err) {
	console.error('[wicnode] Unexpected error:', err);
	process.exit(1);
});
