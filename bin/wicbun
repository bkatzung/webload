#!/usr/bin/env bun

/**
 * wicbun: Web-Import-with-Cache runner for Bun
 */

import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { resolveConfig } from '../src/config.js';
import { validateScriptSrc } from '../src/security.js';
import { isCached, getCachePath } from '../src/cache.js';
import { fetchSync } from '../src/node/sync-fetch.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const pluginPath = path.resolve(__dirname, '../src/bun/plugin.js');
const VERSION = '0.1.0';

function printHelp () {
	console.log(`
WebLoad Bun Runner (wicbun)

Usage:
  wicbun [options] <file-or-url> [script-args...]

Options:
  --config <path>    Specify path to webload.json configuration
  -h, --help         Show this help message
  -v, --version      Show version
`);
}

async function main () {
	const args = process.argv.slice(2);
	const help = args.includes('-h') || args.includes('--help');

	if (args.length === 0 || help) {
		printHelp();
		process.exit(help ? 0 : 1);
	}

	if (args.includes('-v') || args.includes('--version')) {
		console.log(`wicbun ${VERSION}`);
		process.exit(0);
	}

	let configPath = null;
	const bunArgs = [];
	let entrypoint = null;
	const scriptArgs = [];

	let i = 0;
	while (i < args.length) {
		const arg = args[i];

		if (arg === '--config') {
			configPath = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--config=')) {
			configPath = arg.slice(9);
			i += 1;
		} else if (!entrypoint && !arg.startsWith('-')) {
			entrypoint = arg;
			i += 1;
			scriptArgs.push(...args.slice(i));
			break;
		} else {
			if (!entrypoint) {
				bunArgs.push(arg);
			} else {
				scriptArgs.push(arg);
			}
			i += 1;
		}
	}

	if (!entrypoint) {
		console.error('Error: No entrypoint script or URL specified.');
		printHelp();
		process.exit(1);
	}

	const config = resolveConfig(configPath);
	let targetFile = entrypoint;

	// Check if entrypoint is a remote URL
	if (/^https?:\/\//i.test(entrypoint)) {
		try {
			validateScriptSrc(entrypoint, config.scriptSrc);
		} catch (err) {
			console.error(err.message);
			process.exit(1);
		}

		const cacheDir = config.cacheDir;
		if (!isCached(entrypoint, cacheDir)) {
			try {
				const result = fetchSync(entrypoint, { cacheDir });
				targetFile = result.filePath;
			} catch (err) {
				console.error(`[wicbun] Failed to load remote entrypoint: ${err.message}`);
				process.exit(1);
			}
		} else {
			targetFile = getCachePath(entrypoint, cacheDir);
		}
	}

	const env = Object.assign({}, process.env);
	if (configPath) {
		env.WEBLOAD_CONFIG = path.resolve(process.cwd(), configPath);
	}

	const bunExecutable = process.versions.bun ? process.execPath : 'bun';
	const finalArgs = [
		'run',
		'-r', pluginPath,
		...bunArgs,
		targetFile,
		...scriptArgs
	];

	if (process.platform !== 'win32' && typeof process.execve === 'function') {
		try {
			const fullArgv = [bunExecutable, ...finalArgs];
			process.execve(bunExecutable, fullArgv, env);
			return;
		} catch {
			// Fallback to spawn if execve fails on binary name resolution
		}
	}

	const child = spawn(bunExecutable, finalArgs, {
		stdio: 'inherit',
		env
	});

	child.on('exit', function (code, signal) {
		if (signal) {
			process.kill(process.pid, signal);
		} else {
			process.exit(code ?? 0);
		}
	});
}

main().catch(function (err) {
	console.error('[wicbun] Unexpected error:', err);
	process.exit(1);
});
