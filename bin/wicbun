#!/usr/bin/env bun

/**
 * wicbun: Web-Import-with-Cache runner for Bun
 */

import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const pluginPath = path.resolve(__dirname, '../src/bun/plugin.js');
const VERSION = '0.2.0';

function printHelp () {
	console.log(`
WebLoad Bun Runner (wicbun)

Usage:
  wicbun [options] <file-or-url> [script-args...]
  wicbun [options] -e, --eval <code> [script-args...]
  wicbun [options] --test [test-files...]

Options:
  -e, --eval <code>  Evaluate string as JavaScript
  --test             Run Bun built-in test runner
  --config <path>    Specify path to webload.json configuration
  -h, --help         Show this help message
  -v, --version      Show version
`);
}

async function main () {
	const args = process.argv.slice(2);
	const help = args.includes('-h') || args.includes('--help');

	if (args.length === 0 || help) {
		printHelp();
		process.exit(help ? 0 : 1);
	}

	if (args.includes('-v') || args.includes('--version')) {
		console.log(`wicbun ${VERSION}`);
		process.exit(0);
	}

	let configPath = null;
	let isEval = false;
	let evalCode = null;
	let isTest = false;
	const testArgs = [];
	const bunArgs = [];
	let entrypoint = null;
	const scriptArgs = [];

	let i = 0;
	while (i < args.length) {
		const arg = args[i];

		if (arg === '--config') {
			configPath = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--config=')) {
			configPath = arg.slice(9);
			i += 1;
		} else if (arg === '-e' || arg === '--eval') {
			isEval = true;
			evalCode = args[i + 1];
			i += 2;
			scriptArgs.push(...args.slice(i));
			break;
		} else if (arg.startsWith('-e=')) {
			isEval = true;
			evalCode = arg.slice(3);
			i += 1;
			scriptArgs.push(...args.slice(i));
			break;
		} else if (arg.startsWith('--eval=')) {
			isEval = true;
			evalCode = arg.slice(7);
			i += 1;
			scriptArgs.push(...args.slice(i));
			break;
		} else if (arg === '--test' || arg.startsWith('--test-') || arg.startsWith('--test=')) {
			isTest = true;
			if (arg !== '--test') {
				testArgs.push(arg);
			}
			i += 1;
		} else if (!entrypoint && !isTest && !arg.startsWith('-')) {
			entrypoint = arg;
			i += 1;
			scriptArgs.push(...args.slice(i));
			break;
		} else {
			if (isTest) {
				testArgs.push(arg);
			} else if (!entrypoint) {
				bunArgs.push(arg);
			} else {
				scriptArgs.push(arg);
			}
			i += 1;
		}
	}

	if (!entrypoint && !isEval && !isTest) {
		console.error('Error: No entrypoint script, eval code, or --test option specified.');
		printHelp();
		process.exit(1);
	}

	if (isEval && evalCode == null) {
		console.error('Error: -e/--eval option requires code argument.');
		process.exit(1);
	}

	const env = Object.assign({}, process.env);
	if (configPath) {
		env.WEBLOAD_CONFIG = path.resolve(process.cwd(), configPath);
	}

	const bunExecutable = process.versions.bun ? process.execPath : 'bun';
	let finalArgs;

	if (isEval) {
		finalArgs = [
			'-r', pluginPath,
			...bunArgs,
			'-e', evalCode,
			...scriptArgs
		];
	} else if (isTest) {
		finalArgs = [
			'test',
			'-r', pluginPath,
			...bunArgs,
			...testArgs,
			...scriptArgs
		];
	} else {
		env.WEBLOAD_MAIN = entrypoint;
		finalArgs = [
			// 'run',
			'-r', pluginPath,
			...bunArgs,
			// entrypoint,
			'-e', 'import {} from "WEBLOAD:MAIN"',
			...scriptArgs
		];
	}

	if (process.platform !== 'win32' && typeof process.execve === 'function') {
		try {
			const fullArgv = [bunExecutable, ...finalArgs];
			process.execve(bunExecutable, fullArgv, env);
			return;
		} catch {
			// Fallback to spawn if execve fails on binary name resolution
		}
	}

	const child = spawn(bunExecutable, finalArgs, {
		stdio: 'inherit',
		env
	});

	child.on('exit', function (code, signal) {
		if (signal) {
			process.kill(process.pid, signal);
		} else {
			process.exit(code ?? 0);
		}
	});
}

main().catch(function (err) {
	console.error('[wicbun] Unexpected error:', err);
	process.exit(1);
});
