#!/usr/bin/env node

/**
 * wicutil: Web-Import-with-Cache management utility
 */

import { resolveConfig } from '../src/config.js';
import { clearCache, listCache, removeCache } from '../src/cache.js';
import { fetchSync } from '../src/node/sync-fetch.js';

const VERSION = '0.5.0';

function printHelp () {
	console.log(`
WebLoad Cache Management Utility (wicutil)

Usage:
  wicutil [options]

Commands:
  --list                 List all cached modules
  --clear                Purge the entire module cache
  --remove <URL...>      Remove specific modules from cache by URL
  --preload <URL...>     Pre-populate cache with remote module URL(s)

Options:
  --integrity <hash>     Expected Subresource Integrity hash (single URL preload)
  --force                Force cache overwrite and integrity recalculation
  --config <path>        Use specific webload.json configuration
  --cache-dir <path>     Specify custom cache directory
  -h, --help             Show this help message
  -v, --version          Show version
`);
}

function formatBytes (bytes) {
	if (bytes === 0) return '0 B';
	const k = 1024;
	const sizes = ['B', 'KB', 'MB', 'GB'];
	const i = Math.floor(Math.log(bytes) / Math.log(k));
	return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
}

async function main () {
	const args = process.argv.slice(2);
	const help = args.includes('-h') || args.includes('--help');

	if (args.length === 0 || help) {
		printHelp();
		process.exit(help ? 0 : 1);
	}

	if (args.includes('-v') || args.includes('--version')) {
		console.log(`wicutil ${VERSION}`);
		process.exit(0);
	}

	let configPath = null;
	let customCacheDir = null;
	let isList = false;
	let isClear = false;
	let isForce = false;
	let preloadIntegrity = null;
	const removeUrls = [];
	const preloadUrls = [];
	let hasPreloadFlag = false;

	let i = 0;
	while (i < args.length) {
		const arg = args[i];

		if (arg === '--config') {
			configPath = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--config=')) {
			configPath = arg.slice(9);
			i += 1;
		} else if (arg === '--cache-dir') {
			customCacheDir = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--cache-dir=')) {
			customCacheDir = arg.slice(12);
			i += 1;
		} else if (arg === '--list') {
			isList = true;
			i += 1;
		} else if (arg === '--clear') {
			isClear = true;
			i += 1;
		} else if (arg === '--force') {
			isForce = true;
			i += 1;
		} else if (arg === '--integrity') {
			preloadIntegrity = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--integrity=')) {
			preloadIntegrity = arg.slice(12);
			i += 1;
		} else if (arg === '--remove') {
			i += 1;
			while (i < args.length && !args[i].startsWith('-')) {
				removeUrls.push(args[i]);
				i += 1;
			}
		} else if (arg === '--preload') {
			hasPreloadFlag = true;
			i += 1;
			while (i < args.length && !args[i].startsWith('-')) {
				preloadUrls.push(args[i]);
				i += 1;
			}
		} else {
			i += 1;
		}
	}

	if (preloadIntegrity && !hasPreloadFlag) {
		console.error('[wicutil] Error: --integrity option can only be used with --preload.');
		process.exit(1);
	}

	if (hasPreloadFlag && preloadIntegrity && preloadUrls.length !== 1) {
		console.error('[wicutil] Error: --integrity option can only be specified when preloading a single URL.');
		process.exit(1);
	}

	const config = resolveConfig(configPath, {
		cacheDir: customCacheDir
	});
	const cacheDir = config.cacheDir;

	if (isClear) {
		const cleared = clearCache(cacheDir);
		if (cleared) {
			console.log(`[wicutil] Cache cleared successfully: ${cacheDir}`);
		} else {
			console.log(`[wicutil] Cache directory does not exist: ${cacheDir}`);
		}
		return;
	}

	if (removeUrls.length > 0) {
		const removed = removeCache(removeUrls, cacheDir);
		console.log(`[wicutil] Removed ${removed} cached module(s).`);
		return;
	}

	if (hasPreloadFlag) {
		if (preloadUrls.length === 0) {
			console.error('[wicutil] Error: --preload requires at least one URL.');
			process.exit(1);
		}

		for (const url of preloadUrls) {
			try {
				fetchSync(url, {
					cacheDir,
					scriptSrc: config.scriptSrc,
					timeout: config.timeout,
					integrity: preloadIntegrity,
					force: isForce
				});
				console.log(`[wicutil] Preloaded: ${url}`);
			} catch (err) {
				console.error(`[wicutil] Error preloading '${url}': ${err.message}`);
				process.exit(1);
			}
		}
		return;
	}

	if (isList) {
		const items = listCache(cacheDir);
		if (items.length === 0) {
			console.log(`[wicutil] Cache is empty (${cacheDir}).`);
			return;
		}

		console.log(`[wicutil] Cached modules in ${cacheDir} (${items.length} total):\n`);
		for (const item of items) {
			const sizeStr = formatBytes(item.size);
			const dateStr = item.cachedAt || 'unknown';
			console.log(`- URL:  ${item.url}`);
			console.log(`  Path: ${item.filePath}`);
			console.log(`  Size: ${sizeStr} | Cached: ${dateStr}`);
			if (item.integrity) {
				console.log(`  SRI:  ${item.integrity}`);
			}
			console.log('');
		}
		return;
	}

	printHelp();
}

main().catch(function (err) {
	console.error('[wicutil] Unexpected error:', err);
	process.exit(1);
});
