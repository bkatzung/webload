#!/usr/bin/env node

/**
 * wicutil: Web-Import-with-Cache management utility
 */

import { resolveConfig } from '../src/config.js';
import { clearCache, listCache, removeCache } from '../src/cache.js';

const VERSION = '0.3.0';

function printHelp () {
	console.log(`
WebLoad Cache Management Utility (wicutil)

Usage:
  wicutil [options]

Commands:
  --list                 List all cached modules
  --clear                Purge the entire module cache
  --remove <URL...>      Remove specific modules from cache by URL

Options:
  --config <path>        Use specific webload.json configuration
  --cache-dir <path>     Specify custom cache directory
  -h, --help             Show this help message
  -v, --version          Show version
`);
}

function formatBytes (bytes) {
	if (bytes === 0) return '0 B';
	const k = 1024;
	const sizes = ['B', 'KB', 'MB', 'GB'];
	const i = Math.floor(Math.log(bytes) / Math.log(k));
	return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
}

async function main () {
	const args = process.argv.slice(2);
	const help = args.includes('-h') || args.includes('--help');

	if (args.length === 0 || help) {
		printHelp();
		process.exit(help ? 0 : 1);
	}

	if (args.includes('-v') || args.includes('--version')) {
		console.log(`wicutil ${VERSION}`);
		process.exit(0);
	}

	let configPath = null;
	let customCacheDir = null;
	let isList = false;
	let isClear = false;
	const removeUrls = [];

	let i = 0;
	while (i < args.length) {
		const arg = args[i];

		if (arg === '--config') {
			configPath = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--config=')) {
			configPath = arg.slice(9);
			i += 1;
		} else if (arg === '--cache-dir') {
			customCacheDir = args[i + 1];
			i += 2;
		} else if (arg.startsWith('--cache-dir=')) {
			customCacheDir = arg.slice(12);
			i += 1;
		} else if (arg === '--list') {
			isList = true;
			i += 1;
		} else if (arg === '--clear') {
			isClear = true;
			i += 1;
		} else if (arg === '--remove') {
			i += 1;
			while (i < args.length && !args[i].startsWith('-')) {
				removeUrls.push(args[i]);
				i += 1;
			}
		} else {
			i += 1;
		}
	}

	const config = resolveConfig(configPath, {
		cacheDir: customCacheDir
	});
	const cacheDir = config.cacheDir;

	if (isClear) {
		const cleared = clearCache(cacheDir);
		if (cleared) {
			console.log(`[wicutil] Cache cleared successfully: ${cacheDir}`);
		} else {
			console.log(`[wicutil] Cache directory does not exist: ${cacheDir}`);
		}
		return;
	}

	if (removeUrls.length > 0) {
		const removed = removeCache(removeUrls, cacheDir);
		console.log(`[wicutil] Removed ${removed} cached module(s).`);
		return;
	}

	if (isList) {
		const items = listCache(cacheDir);
		if (items.length === 0) {
			console.log(`[wicutil] Cache is empty (${cacheDir}).`);
			return;
		}

		console.log(`[wicutil] Cached modules in ${cacheDir} (${items.length} total):\n`);
		for (const item of items) {
			const sizeStr = formatBytes(item.size);
			const dateStr = item.cachedAt || 'unknown';
			console.log(`- URL:  ${item.url}`);
			console.log(`  Path: ${item.filePath}`);
			console.log(`  Size: ${sizeStr} | Cached: ${dateStr}\n`);
		}
		return;
	}

	printHelp();
}

main().catch(function (err) {
	console.error('[wicutil] Unexpected error:', err);
	process.exit(1);
});
