{
  "name": "@bkatzung/webload",
  "version": "0.2.0",
  "description": "Seamless URL module loading and caching for Node.js and Bun with CSP-like security and WICG import maps",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "wicnode": "./bin/wicnode",
    "wicbun": "./bin/wicbun",
    "wicutil": "./bin/wicutil"
  },
  "exports": {
    ".": "./src/index.js",
    "./security": "./src/security.js",
    "./config": "./src/config.js",
    "./import-map": "./src/import-map.js",
    "./cache": "./src/cache.js",
    "./bun": "./src/bun/plugin.js",
    "./node": "./src/node/hook.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkatzung/webload.git"
  },
  "bugs": {
    "url": "https://github.com/bkatzung/webload/issues"
  },
  "homepage": "https://github.com/bkatzung/webload#readme",
  "scripts": {
    "test": "node --test test/**/*.test.js"
  },
  "keywords": [
    "esm",
    "url-imports",
    "import-maps",
    "cache",
    "bun",
    "node"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
